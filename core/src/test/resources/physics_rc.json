{"schema": 1, "ok": true, "kind": "physics", "tool": "", "title": "RC circuit", "order": 0, "indep": "t", "dep": "", "input_latex": "R\\,C\\frac{dV_c}{dt} + V_c = V_s", "normal_latex": "R\\,C\\frac{dV_c}{dt} + V_c = V_s", "rhs_expr": null, "ic": null, "summary": "The capacitor reaches 95% of the way to its final value (285 V) after 719 ms (3 time constants).", "other_types": [], "methods": [{"id": "exact", "name": "Exact solution", "applicable": true, "reason": "A linear first-order equation has a closed-form solution.", "steps": [{"title": "Set up the equation from Kirchhoff's voltage law", "text": "Going round the loop, the voltage drops add up to the source voltage. \\(V_c = q/C\\) is the voltage across the capacitor. The current is \\(i = C\\,dV_c/dt\\), and it drops a voltage \\(iR\\) across the resistance. The battery supplies the constant voltage \\(V_s\\).", "latex": ["R\\,C\\frac{dV_c}{dt} + V_c = V_s"], "substeps": []}, {"title": "List the known values", "text": "Everything is converted to SI units before it goes into the equation.", "latex": [], "substeps": [], "table": {"headers": ["\\text{quantity}", "\\text{symbol}", "\\text{given}", "\\text{SI}"], "rows": [["\\text{Resistance}", "R", "2\\ \\mathrm{k\\Omega}", "2000\\ \\mathrm{\\Omega}"], ["\\text{Capacitance}", "C", "120\\ \\mathrm{\\mu F}", "0.00012\\ \\mathrm{F}"], ["\\text{Source voltage}", "V_s", "300\\ \\mathrm{V}", "300\\ \\mathrm{V}"], ["\\text{Initial capacitor voltage}", "V_0", "0\\ \\mathrm{V}", "0\\ \\mathrm{V}"], ["\\text{Fraction of the full change}", "p", "95\\ \\mathrm{\\%}", "0.95"]]}}, {"title": "Solve the differential equation", "text": "This is a linear first-order equation. The capacitor voltage relaxes exponentially towards its final value with time constant \\(\\tau\\).", "latex": ["\\tau = R\\,C = 240\\ \\mathrm{ms}", "V_\\infty = 300\\ \\mathrm{V}", "V_c(t) = V_\\infty + (V_0 - V_\\infty)\\,e^{-t/\\tau}", "i(t) = \\frac{V_s - V_c(t)}{R}"], "substeps": [{"title": "Write in standard form", "text": "Divide by the coefficient of the derivative.", "latex": ["\\frac{dV_c}{dt} + \\frac{1}{\\tau}\\,V_c = \\frac{V_\\infty}{\\tau}"], "substeps": []}, {"title": "Multiply by the integrating factor", "text": "The factor \\(\\mu = e^{t/\\tau}\\) turns the left side into the derivative of a product.", "latex": ["\\mu = e^{t/\\tau}", "\\frac{d}{dt}\\left[e^{t/\\tau}\\,V_c\\right] = \\frac{V_\\infty}{\\tau}\\,e^{t/\\tau}"], "substeps": []}, {"title": "Integrate and divide by the factor", "text": "The constant of integration is \\(K\\).", "latex": ["V_c(t) = V_\\infty + K\\,e^{-t/\\tau}"], "substeps": []}, {"title": "Apply the initial condition", "text": "Set \\(t = 0\\).", "latex": ["K = V_0 - V_\\infty"], "substeps": []}]}, {"title": "Solve for the time", "text": "Set the solution equal to the voltage wanted and take logarithms.", "latex": ["1 - e^{-t/\\tau} = p", "t = -\\tau\\ln(1 - p) = 719\\ \\mathrm{ms}"], "substeps": []}, {"title": "Answer", "text": "The capacitor reaches 95% of the way to its final value (285 V) after 719 ms (3 time constants).", "latex": ["t = -\\tau\\ln(1 - p) = 719\\ \\mathrm{ms}"], "substeps": [], "kind": "answer"}, {"title": "Check", "text": "Checked against a direct step-by-step integration of the circuit equation, and the initial voltage is reproduced.", "latex": [], "substeps": [], "kind": "check-ok"}], "general_latex": null, "particular_latex": "t = -\\tau\\ln(1 - p) = 719\\ \\mathrm{ms}", "plot": {"general_expr": null, "particular_expr": null, "points": []}, "verified": true, "verify_note": "Checked against a direct step-by-step integration of the circuit equation, and the initial voltage is reproduced."}], "physics": {"scenario": "rc", "headline": {"label": "Result", "text": "The capacitor reaches 95% of the way to its final value (285 V) after 719 ms (3 time constants)."}, "x_label": "time (s)", "y_label": "capacitor voltage (V)", "curve": [[0.0, 0.0], [0.002516415109785352, 3.1290858892691062], [0.005032830219570704, 6